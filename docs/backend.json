{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public and private profile information.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The user's unique ID, matching their Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "The user's public display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL for the user's profile picture."
        }
      },
      "required": ["id", "displayName", "email"]
    },
    "AdminRole": {
      "title": "Admin Role",
      "description": "A document whose existence grants a user admin privileges.",
      "type": "object",
      "properties": {
        "is_admin": {
            "type": "boolean",
            "description": "Confirms administrative privileges."
        }
      }
    },
    "Article": {
      "title": "Blog Article",
      "description": "Represents a blog article.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string", "description": "Raw, unformatted content written by the user." },
        "formattedContent": { "type": "string", "description": "AI-formatted content with special markdown." },
        "author": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string", "format": "uri" },
        "language": { "type": "string", "enum": ["ltr", "rtl"] }
      },
      "required": ["id", "title", "description", "content", "author", "date"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores individual user profiles."
    },
    "/roles_admin/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "A collection where the document ID is a user's UID, granting them admin rights."
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Stores individual blog articles."
    }
  }
}
